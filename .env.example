# Server
PORT=3000
NODE_ENV=production

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Optional: path to yt-dlp binary (auto-detected if not set)
YTDLP_PATH=/usr/local/bin/yt-dlp

# Optional: SoundCloud client ID (for fallback)
SOUNDCLOUD_CLIENT_ID=a3e059563d7fd3372b49b37f00a00bcf

# Optional: cookies files for platforms that need login
# Export cookies from your browser using a browser extension like "Get cookies.txt LOCALLY"
# INSTAGRAM_COOKIES_FILE=/path/to/instagram_cookies.txt
# FACEBOOK_COOKIES_FILE=/path/to/facebook_cookies.txt
# LINKEDIN_COOKIES_FILE=/path/to/linkedin_cookies.txt
